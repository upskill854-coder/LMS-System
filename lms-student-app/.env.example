# Base URL of the shared Next.js backend (used by website, admin panel & this app)
EXPO_PUBLIC_API_URL=https://api.yourdomain.com

# WebSocket / Socket.IO URL for realtime chat & live class events
EXPO_PUBLIC_WS_URL=wss://api.yourdomain.com

# Display name used in splash/onboarding
EXPO_PUBLIC_APP_NAME=LMS Student

# Razorpay PUBLIC key only (never put the secret key here)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
